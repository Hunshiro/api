# Comma-separated list of allowed frontend origins for CORS.
# Examples:
# ORIGIN=http://localhost:5173
# ORIGIN=https://your-frontend.vercel.app,https://app.example.com
ORIGIN=*

# Anime source fallback (used for homepage spotlight/trending).
HIANIME_BASE_URL=https://anikai.to

# Kaido.to source (used for anime details, episodes, servers, stream).
KAIDO_BASE_URL=https://kaido.to

# Optional Redis cache (Upstash).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LIMIT=100

# Server bind
HOST=0.0.0.0
PORT=3030
